# ==============================================================================
# ANDX Web2 Assessment - Shared Environment Configuration Template
# ==============================================================================

# Node Environment & Diagnostics
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1024
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 16) Configuration
# ------------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=andx
POSTGRES_PASSWORD=andx_secret
POSTGRES_DB=andx_db
DATABASE_URL=postgresql://andx:andx_secret@postgres:5432/andx_db

# PostgreSQL Performance Tuning & Resource Bounds
POSTGRES_MEM_LIMIT=4096m
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_MAX_WAL_SIZE=8GB
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_WAL_COMPRESSION=on
POSTGRES_MAX_CONNECTIONS=150

# ------------------------------------------------------------------------------
# 2. Message Broker (Redpanda v26.2.3 / Kafka-Compatible) Configuration
# ------------------------------------------------------------------------------
REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v26.2.3
BROKER_CONTAINER_NAME=broker
KAFKA_BROKERS=broker:9092
KAFKA_PORT=9092
BROKER_MEM_LIMIT=2048m
BROKER_MEMORY_RESERVATION=1G
BROKER_SMP=1

# ------------------------------------------------------------------------------
# 3. Kafka Topics
# ------------------------------------------------------------------------------
TOPIC_INGEST_SNAPSHOTS=ingest.snapshots.v1
TOPIC_INGEST_CLIP_TEXT=ingest.clip-text.v1
TOPIC_INGEST_INVALID=ingest.invalid.v1
TOPIC_AGGREGATOR_CLIP_VIEWS=aggregator.clip-views.v1
TOPIC_DLQ_COMMANDS=dlq.commands.v1

# ------------------------------------------------------------------------------
# 4. Gateway Ingestion Service (Port 8080)
# ------------------------------------------------------------------------------
GATEWAY_CONTAINER_NAME=gateway
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_MEM_LIMIT=1536m
GATEWAY_MAX_BODY_SIZE_BYTES=8388608
GATEWAY_MAX_LINE_COUNT=10000

# Backpressure & Lag Thresholds (strictly aggregator-group, NEVER earnings)
LAG_TARGET_CONSUMER_GROUP=aggregator-group
LAG_THRESHOLD_429=400000
LAG_THRESHOLD_503=1500000
LAG_POLL_INTERVAL_MS=1000

# ------------------------------------------------------------------------------
# 5. Aggregator Worker Service
# ------------------------------------------------------------------------------
AGGREGATOR_CONTAINER_NAME=aggregator
AGGREGATOR_MEM_LIMIT=1536m
AGGREGATOR_CONSUMER_GROUP=aggregator-group
AGGREGATOR_BATCH_SIZE=2000
AGGREGATOR_FLUSH_INTERVAL_MS=100

# ------------------------------------------------------------------------------
# 6. Earnings Worker Service
# ------------------------------------------------------------------------------
EARNINGS_CONTAINER_NAME=earnings
EARNINGS_MEM_LIMIT=1536m
EARNINGS_CONSUMER_GROUP=earnings-group
EARNINGS_DEBOUNCE_MS=200

# ------------------------------------------------------------------------------
# 7. Query & Admin API Service (Port 8081)
# ------------------------------------------------------------------------------
API_CONTAINER_NAME=api
API_PORT=8081
API_HOST=0.0.0.0
API_MEM_LIMIT=1536m

# ------------------------------------------------------------------------------
# 8. AI Content Classifier Service
# ------------------------------------------------------------------------------
CLASSIFIER_CONTAINER_NAME=classifier
CLASSIFIER_MEM_LIMIT=1536m
CLASSIFIER_CONSUMER_GROUP=classifier-group
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
